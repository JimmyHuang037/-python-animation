FROM mcr.microsoft.com/playwright:v1.58.2-noble
ARG LOCAL_UID=1000
ARG LOCAL_GID=1000
ARG CODE_SERVER_VERSION=4.139.1
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update && apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    curl ca-certificates git fonts-noto-cjk fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fL --retry 3 --output /tmp/code-server.tar.gz \
    https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz \
    && tar -xzf /tmp/code-server.tar.gz -C /opt && rm /tmp/code-server.tar.gz \
    && ln -s /opt/code-server-${CODE_SERVER_VERSION}-linux-amd64/bin/code-server /usr/local/bin/code-server
RUN groupadd -g ${LOCAL_GID} course && useradd -m -u ${LOCAL_UID} -g ${LOCAL_GID} -s /bin/bash course
COPY docker/ide-entrypoint.py /usr/local/bin/ide-entrypoint.py
ENV HOME=/home/course PYTHONUNBUFFERED=1
WORKDIR /workspace
USER course
ENTRYPOINT ["python3", "/usr/local/bin/ide-entrypoint.py"]
