[Unit]
Description=Python Animation test machine browser ports via WSL SSH

[Service]
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes -L 127.0.0.1:19030:127.0.0.1:9030 -L 127.0.0.1:19042:127.0.0.1:9042 qwer-test
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
